{
  "name": "co-lau",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.mts && next build",
    "start": "next start",
    "lint": "eslint .",
    "docs:check": "tsx scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "sim": "tsx scripts/balance.ts",
