    "db:migrate": "tsx scripts/migrate.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.44.7",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pixi.js": "8.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
