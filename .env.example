# Mẫu biến môi trường cho Cờ Lau (Reed-Banner).
# Chép thành .env.local rồi điền giá trị thật: cp .env.example .env.local
# .env.local đã nằm trong .gitignore; KHÔNG commit bí mật thật. Trên Vercel đặt ở Settings > Environment Variables.
# Biến để trống thì tính năng tương ứng tự tắt hoặc chạy chế độ dự phòng (ghi rõ ở từng dòng).

# ---------------------------------------------------------------------------
# Cơ sở dữ liệu
# ---------------------------------------------------------------------------

# Chuỗi kết nối Postgres (Neon). Để trống: server lưu trong bộ nhớ (mất khi tắt), `pnpm build` bỏ qua migration.
DATABASE_URL=
# Ví dụ: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Phiên đăng nhập
# ---------------------------------------------------------------------------

# Khóa ký cookie khách (HMAC), cũng làm seed cho Nhật Lệnh và Tháp Thiên Mệnh. Bắt buộc ở production.
# Tạo chuỗi ngẫu nhiên: openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Đăng nhập OAuth (thiếu cặp nào thì nút đăng nhập đó bị ẩn)
# Callback: <tên miền>/api/auth/google/callback và <tên miền>/api/auth/github/callback
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Gửi email (lấy lại mật khẩu, xác nhận email). Production thiếu SMTP_HOST hoặc SMTP_FROM thì ẩn form email;
# khi dev chưa cấu hình thì thư được in ra console.
# ---------------------------------------------------------------------------

# Ví dụ Gmail: smtp.gmail.com, cổng 587, mật khẩu ứng dụng (không phải mật khẩu Gmail).
SMTP_HOST=
# Mặc định 587.
SMTP_PORT=
# "true" dùng TLS ngay từ đầu; để trống thì tự bật khi cổng là 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Địa chỉ người gửi, ví dụ: Cờ Lau <ten-ban@gmail.com>
SMTP_FROM=

# ---------------------------------------------------------------------------
# Vercel Cron (/api/cron/daily). Vercel gửi kèm "Authorization: Bearer <CRON_SECRET>".
# Để trống thì route cron từ chối mọi yêu cầu.
# ---------------------------------------------------------------------------

CRON_SECRET=

# ---------------------------------------------------------------------------
# Cờ tính năng: chỉ chuỗi "true" mới bật, để trống hoặc giá trị khác là tắt.
# ---------------------------------------------------------------------------

# Tháp Thí Luyện (Trial), /game/trial.
TRIAL_ENABLED=
# Tháp Thiên Mệnh (Destiny), /game/destiny.
DESTINY_ENABLED=
# Trận Đồ xếp hạng và thưởng.
FORMATION_RANKED_ENABLED=
# Tầm Tướng Ký: mở chế độ Thường, Hạng tuần và mọi gói đã duyệt (không phân biệt hoa thường).
TAM_TUONG_KY_ENABLED=
# Viễn Chinh.
EXPEDITION_ENABLED=

# ---------------------------------------------------------------------------
# Chỉ dùng cho script kiểm tra (không cần để chạy game)
# ---------------------------------------------------------------------------

# scripts/neon-staging-audit.mts: đọc nhánh Neon STAGING, chỉ đọc, không bao giờ dùng DATABASE_URL.
STAGING_DATABASE_URL=
STAGING_EXPECTED_HOST=
STAGING_EXPECTED_DATABASE=
NEON_STAGING_BRANCH_NAME=
NEON_STAGING_BRANCH_ID=
# Phải là đúng chuỗi I_HAVE_VERIFIED_NEON_STAGING sau khi đã tự kiểm tra đó là nhánh staging.
STAGING_SAFETY_CONFIRMATION=

# scripts/browser-*-audit.cjs: thư mục lưu ảnh chụp và kết quả.
AUDIT_OUTPUT_DIR=
# scripts/browser-spirit-audit.cjs: luật Tinh thần cần thử (mặc định A), bỏ qua phần chụp giao diện, in debug bố cục.
AUDIT_RULE=
AUDIT_ONLY_FIXTURE=
AUDIT_LAYOUT_DEBUG=

# ---------------------------------------------------------------------------
# Liên kết ngoài ở footer và phần "Kết giao bốn phương" (mạng xã hội) ở Chiến trường
# Chỉ đặt địa chỉ https công khai: biến NEXT_PUBLIC_* được nhúng vào bản build.
# ---------------------------------------------------------------------------

# KHÓA LIÊN KẾT NGOÀI: mặc định (để trống) mọi liên kết ngoài và mạng xã hội vẫn hiện nhưng bấm không chuyển trang, không hiện
# thông báo. Đặt true khi đã cập nhật xong địa chỉ để mở khóa; khi đó mục nào có địa chỉ https sẽ thành liên kết thật (mở thẻ mới).
NEXT_PUBLIC_LINKS_UNLOCKED=

# Bốn mục ở footer (Góp ý và báo lỗi, Cộng đồng, Điều khoản, Quyền riêng tư). Nội dung điều khoản và quyền riêng tư cần người am hiểu
# pháp lý duyệt trước khi công bố.
NEXT_PUBLIC_FEEDBACK_URL=
NEXT_PUBLIC_COMMUNITY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Mạng xã hội liên hệ. Địa chỉ mặc định của chủ game nằm trong src/app/game/footerLinks.ts (Facebook, TikTok, LinkedIn, GitHub);
# Instagram, Discord, X chưa có nhưng vẫn hiện. Đặt biến dưới đây để ghi đè hoặc thêm địa chỉ mới mà không sửa code
# (YouTube và Zalo chỉ hiện khi có địa chỉ).
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_ZALO=
